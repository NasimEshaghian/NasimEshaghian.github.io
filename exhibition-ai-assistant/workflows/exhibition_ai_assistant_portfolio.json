    {
      "parameters": {
        "jsCode": "const raw = $input.first()?.json?.data?.exhibition_main || $input.first()?.json?.exhibition_main || {};\n\nconst safe = (v, fallback = \"نامشخص\") =>\n  v === null || v === undefined || String(v).trim() === \"\" ? fallback : String(v).trim();\n\nconst exName = safe(raw.exhibition_name, \"اولین نمایشگاه بین‌المللی هوش مصنوعی (AIX)\");\nconst exLoc = safe(raw.location);\nconst exDate = safe(raw.date, \"۲۲ تا ۲۵ مهر ۱۴۰۴\");\nconst exHours = safe(raw.visiting_hours, \"۸ صبح تا ۳ بعدازظهر\");\nconst exSupport = safe(raw.support);\nconst exPrice = safe(raw.entry_ticket, \"رایگان\");\n\nconst dataPoints = [\n  {\n    topic: \"overview\",\n    content: `${exName} در محل ${exLoc} برگزار می‌شود و میزبان شرکت‌ها و فعالان حوزه هوش مصنوعی است.`\n  },\n  {\n    topic: \"halls\",\n    content: `برای بازدید از بخش‌های مختلف ${exName} می‌توانید به ${safe(raw.halls)} مراجعه کنید.`\n  },\n  {\n    topic: \"date_and_time\",\n    content: `برنامه زمانی ${exName}: تاریخ ${exDate}، ساعات بازدید ${exHours}.`\n  },\n  {\n    topic: \"entry_rules\",\n    content: `شرایط حضور در ${exName}: ورود با QR Code ثبت‌نام انجام می‌شود و بلیط در بخش «بلیط‌های قبلی» در دسترس است.`\n  },\n  {\n    topic: \"support\",\n    content: `پشتیبانی ${exName}: ${exSupport}.`\n  }\n];\n\nreturn dataPoints.map((item) => ({\n  json: {\n    content: item.content,\n    metadata: {\n      type: \"general_info\",\n      category: \"exhibition_info\",\n      topic: item.topic,\n      location: exLoc,\n      exhibition_name: exName,\n      price: exPrice,\n      start_time: safe(raw.start_time, \"2025-10-22 08:00\"),\n      end_time: safe(raw.end_time, \"2025-10-25 15:00\"),\n      capacity: safe(raw.capacity, \"نامحدود\")\n    }\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        -40
      ],
      "id": "a1000001-0001-4000-8000-000000000008",
