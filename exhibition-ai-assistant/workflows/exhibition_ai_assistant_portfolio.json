    {
      "parameters": {
        "jsCode": "const rawInput = $input.first()?.json;\nconst rawEvents = Array.isArray(rawInput?.data?.events)\n  ? rawInput.data.events\n  : Array.isArray(rawInput?.events)\n    ? rawInput.events\n    : [];\n\nreturn rawEvents.map((ev) => {\n  const title = (ev.title || ev.topic || \"رویداد بدون نام\").toString().trim();\n  const location = (ev.location || \"نامشخص\").toString().trim();\n  const date = ev.start_date || (ev.startAt ? String(ev.startAt).split(\"T\")[0] : \"نامشخص\");\n  const startTime = ev.start_time || ev.eventTimeFrom || \"نامشخص\";\n  const endTime = ev.end_time || ev.eventTimeTo || \"نامشخص\";\n  const ticketPrice = ev.ticket_price !== undefined ? ev.ticket_price : (ev.ticketPrice ?? 0);\n  const isFree = ev.is_free !== undefined ? Boolean(ev.is_free) : Number(ticketPrice) === 0;\n  const capacity = ev.capacity ?? \"نامشخص\";\n\n  const content = [\n    `عنوان رویداد: ${title}`,\n    `محل برگزاری: ${location}`,\n    `تاریخ برگزاری: ${date}`,\n    `بازه زمانی: ${startTime} تا ${endTime}`,\n    `وضعیت هزینه: ${isFree ? \"رایگان\" : `${ticketPrice} تومان`}`,\n    `ظرفیت: ${capacity}`\n  ].join(\" | \");\n\n  return {\n    json: {\n      content,\n      metadata: {\n        type: \"events\",\n        category: \"exhibition_info\",\n        topic: title,\n        event_id: ev.event_id || ev.id || \"\",\n        location,\n        start_date: date,\n        start_time: startTime,\n        end_time: endTime,\n        is_free: isFree,\n        ticket_price: ticketPrice,\n        capacity\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
