    {
      "parameters": {
        "jsCode": "const rawInput = $input.first()?.json;\nconst booths = Array.isArray(rawInput?.data)\n  ? rawInput.data\n  : Array.isArray(rawInput)\n    ? rawInput\n    : [];\n\nconst safeStr = (val, fallback = \"نامشخص\") => {\n  if (val === null || val === undefined || val === \"-\" || String(val).trim() === \"\") {\n    return fallback;\n  }\n  return String(val).trim();\n};\n\n// Configurable placeholder map URLs per hall group\nconst hallMaps = {\n  \"8 - 9\": \"REPLACE_WITH_HALL_8_9_MAP_URL\",\n  \"10 - 11\": \"REPLACE_WITH_HALL_10_11_MAP_URL\"\n};\n\nreturn booths\n  .map((item) => {\n    const meta = item.metadata || {};\n    const companyName = safeStr(item.company_name || item[\"اسم شرکت\"] || meta.company);\n    const hall = safeStr(item.hall || item[\"شماره سالن\"] || meta.hall);\n    const boothNumber = safeStr(item.booth_number || item[\"شماره غرفه\"] || meta.booth_number);\n    const topic = safeStr(item.activity_field || item[\"حوزه فعالیت\"] || meta.field || item.topic || \"عمومی\");\n    const accessPath = safeStr(\n      item.access_path || item[\"مسیر نسبی از ورودی جنوب\"] || meta.access_path,\n      \"مراجعه به نقشه سالن\"\n    );\n\n    const content =\n      item.content &&\n      item.content.includes(\"مسیر دسترسی\") &&\n      item.content.includes(\"غرفه شماره\")\n        ? String(item.content).trim()\n        : `غرفه شرکت ${companyName} در سالن ${hall} و غرفه شماره ${boothNumber} قرار دارد. حوزه فعالیت: ${topic}. مسیر دسترسی: ${accessPath}.`;\n\n    return {\n      json: {\n        content,\n        metadata: {\n          type: \"booth_info\",\n          category: \"exhibition_info\",\n          topic,\n          company_name: companyName,\n          hall,\n          booth_number: boothNumber,\n          access_path: accessPath,\n          map_url: item.map_url || meta.map_url || hallMaps[hall] || \"\"\n        }\n      }\n    };\n  })\n  .filter((entry) => Boolean(entry.json.content));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        -240
      ],
