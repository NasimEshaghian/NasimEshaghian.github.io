    {
      "parameters": {
        "jsCode": "const body = $input.first()?.json?.body || $input.first()?.json || {};\nconst rawMessage = typeof body.message === \"string\"\n  ? body.message.trim()\n  : typeof body.chatInput === \"string\"\n    ? body.chatInput.trim()\n    : \"\";\n\nif (!rawMessage) {\n  return [\n    {\n      json: {\n        valid: false,\n        sessionId: body.sessionId || `anon_${Date.now()}`,\n        message: \"\",\n        errorMessage: \"پیام ورودی خالی است. لطفاً سؤال یا موضوع مورد نظر خود درباره نمایشگاه را بنویسید.\"\n      }\n    }\n  ];\n}\n\nconst providedSession = typeof body.sessionId === \"string\" && body.sessionId.trim().length > 0\n  ? body.sessionId.trim()\n  : `anon_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;\n\nreturn [\n  {\n    json: {\n      valid: true,\n      sessionId: providedSession,\n      message: rawMessage\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        620
      ],
      "id": "a1000001-0001-4000-8000-000000000017",
      "name": "Normalize Anonymous Session"
    },
