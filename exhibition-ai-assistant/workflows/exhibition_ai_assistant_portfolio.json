          "value": {
            "full_name": "={{ $fromAI('full_name', 'Visitor full name in Persian or as provided', 'string') }}",
            "event_name": "={{ $fromAI('event_name', 'Selected exhibition event title', 'string') }}",
            "event_date": "={{ $fromAI('event_date', 'Event date', 'string') }}",
            "start_time": "={{ $fromAI('start_time', 'Event start time', 'string') }}",
            "end_time": "={{ $fromAI('end_time', 'Event end time', 'string') }}",
            "event_location": "={{ $fromAI('event_location', 'Event hall or location', 'string') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "full_name",
              "displayName": "full_name",
              "required": true,
              "type": "string",
              "defaultMatch": false,
              "canBeUsedToMatch": false
            },
            {
              "id": "event_name",
              "displayName": "event_name",
              "required": true,
              "type": "string",
              "defaultMatch": false,
              "canBeUsedToMatch": false
            },
            {
              "id": "event_date",
              "displayName": "event_date",
              "required": true,
              "type": "string",
