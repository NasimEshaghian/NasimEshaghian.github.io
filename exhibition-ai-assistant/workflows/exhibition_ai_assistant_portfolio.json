    {
      "parameters": {
        "description": "Sandbox demo booking tool ONLY. Use ONLY when a visitor explicitly wants to test/simulate booking an exhibition event and has provided their full_name and selected event details (event_name, event_date, start_time, end_time, event_location). Creates a simulated demo reservation in the sandbox table—never a real exhibition booking.",
        "workflowId": {
