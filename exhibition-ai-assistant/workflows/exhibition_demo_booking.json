    {
      "parameters": {
        "jsCode": "const raw = $input.first()?.json || {};\n\nconst requiredFields = [\n  \"full_name\",\n  \"event_name\",\n  \"event_date\",\n  \"start_time\",\n  \"end_time\",\n  \"event_location\"\n];\n\nconst missing = requiredFields.filter(\n  (field) => !raw[field] || String(raw[field]).trim() === \"\"\n);\n\nif (missing.length > 0) {\n  return [\n    {\n      json: {\n        valid: false,\n        missing_fields: missing,\n        message: `اطلاعات زیر برای رزرو آزمایشی (Sandbox) ناقص است: ${missing.join(\", \")}`\n      }\n    }\n  ];\n}\n\nconst randomPart = Math.random().toString(36).substring(2, 8).toUpperCase();\nconst bookingId = `DEMO-${Date.now()}-${randomPart}`;\n\nreturn [\n  {\n    json: {\n      valid: true,\n      full_name: String(raw.full_name).trim(),\n      event_name: String(raw.event_name).trim(),\n      event_date: String(raw.event_date).trim(),\n      start_time: String(raw.start_time).trim(),\n      end_time: String(raw.end_time).trim(),\n      event_location: String(raw.event_location).trim(),\n      booking_mode: \"sandbox\",\n      booking_status: \"simulated_confirmed\",\n      booking_id: bookingId,\n      is_simulated: true,\n      created_at: new Date().toISOString()\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        0
      ],
      "id": "b2000002-0002-4000-8000-000000000002",
      "name": "Validate & Build Sandbox Record"
    },
