    {
      "parameters": {
        "jsCode": "const built = $('Validate & Build Sandbox Record').first().json;\n\nreturn [\n  {\n    json: {\n      ok: true,\n      simulation_notice: \"این یک رزرو آزمایشی (Sandbox Demo) است و رزرو واقعی در سامانه نمایشگاه ثبت نشده است.\",\n      booking_id: built.booking_id,\n      booking_mode: \"sandbox\",\n      booking_status: built.booking_status,\n      full_name: built.full_name,\n      event_name: built.event_name,\n      event_date: built.event_date,\n      start_time: built.start_time,\n      end_time: built.end_time,\n      event_location: built.event_location\n    }\n  }\n];"
